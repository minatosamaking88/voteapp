# Local PostgreSQL application database. Keep sslmode=disable for local PostgreSQL.
DATABASE_URL="postgresql://postgres:change-me@localhost:5432/feature_board?sslmode=disable"

# Isolated integration-test database; must not be the application database.
TEST_DATABASE_URL="postgresql://postgres:change-me@localhost:5432/feature_board_test?sslmode=disable"

# Server configuration
PORT=4000
NODE_ENV=development
WEB_ORIGIN=http://localhost:5173
TRUST_PROXY_HOPS=0

# Required by the explicit demo seed. Replace each value before seeding.
DEMO_ADMIN_EMAIL=admin@example.test
DEMO_ADMIN_PASSWORD=replace-with-a-long-random-password
DEMO_USER_A_EMAIL=user-a@example.test
DEMO_USER_A_PASSWORD=replace-with-a-long-random-password
DEMO_USER_B_EMAIL=user-b@example.test
DEMO_USER_B_PASSWORD=replace-with-a-long-random-password
